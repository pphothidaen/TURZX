#!/usr/bin/env bash
# ==============================================================================
# TURXZ Strict Pre-Commit Hook
# Validates Agent JSON schemas, Python syntax, and code quality before commit.
# ==============================================================================
set -euo pipefail

# ANSI color codes for clear terminal output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo -e "${BLUE}${BOLD}[TURXZ Pre-Commit]${NC} Initiating strict validation gates..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Determine python executable
if [ -x ".venv/bin/python" ]; then
    PYTHON_BIN=".venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="python3"
else
    echo -e "${RED}[ERROR]${NC} Python 3 executable not found in PATH or .venv."
    exit 1
fi

# ------------------------------------------------------------------------------
# Gate 1: Agent JSON Schema Validation
# ------------------------------------------------------------------------------
echo -e "${BLUE}[Gate 1/3]${NC} Validating AI Agent definitions in .agents/ai/..."

AGENT_VALIDATION_SCRIPT="
import sys, glob, json

required_keys = [
    'id', 'name', 'version', 'category',
    'capabilities', 'permissions', 'resource_boundaries', 'governance'
]
required_agents = {
    'turzx-core-agent',
    'turzx-hardware-agent',
    'turzx-integration-agent',
    'turzx-scheduler-agent',
    'turzx-test-agent'
}
required_gov_keys = {
    'zero_assumption_compliance',
    'fail_closed_on_error',
    'enforce_local_process_token'
}

json_files = glob.glob('.agents/ai/**/*.json', recursive=True)
if len(json_files) < 5:
    print(f'ERROR: Expected at least 5 agent definitions, found {len(json_files)}')
    sys.exit(1)

errors = []
found_agents = set()

for file_path in json_files:
    try:
        with open(file_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        for key in required_keys:
            if key not in data:
                errors.append(f'{file_path}: missing required key \"{key}\"')
        agent_id = data.get('id')
        if agent_id:
            found_agents.add(agent_id)
        if 'governance' in data:
            if not isinstance(data['governance'], dict):
                errors.append(f'{file_path}: \"governance\" must be an object')
            else:
                for gov_k in required_gov_keys:
                    if gov_k not in data['governance']:
                        errors.append(f'{file_path}: governance missing required rule \"{gov_k}\"')
    except Exception as exc:
        errors.append(f'{file_path}: invalid JSON - {exc}')

missing_required = required_agents - found_agents
if missing_required:
    errors.append(f'Missing required agents in catalog: {sorted(missing_required)}')

if errors:
    print('\n'.join(errors))
    sys.exit(1)

print(f'Successfully validated {len(json_files)} agent definitions: {sorted(found_agents)}')
"

if ! $PYTHON_BIN -c "$AGENT_VALIDATION_SCRIPT"; then
    echo -e "${RED}${BOLD}[FAIL] Agent JSON Schema Validation Failed!${NC}"
    echo -e "${YELLOW}Remediation:${NC}"
    echo "  1. Verify the JSON syntax in .agents/ai/turzx/*.json using a JSON validator."
    echo "  2. Ensure all required fields ('id', 'name', 'version', 'category', 'capabilities', 'permissions', 'resource_boundaries', 'governance') are populated."
    echo "  3. Refer to AGENTS.md for complete schema definitions."
    exit 1
fi
echo -e "${GREEN}[PASS]${NC} All Agent JSON definitions are valid and conform to schema."

# ------------------------------------------------------------------------------
# Gate 2: Python Syntax Compilation Check
# ------------------------------------------------------------------------------
echo -e "${BLUE}[Gate 2/3]${NC} Verifying Python syntax compilation..."

STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$STAGED_PY_FILES" ]; then
    while IFS= read -r py_file; do
        [ -z "$py_file" ] && continue
        if [ -f "$py_file" ]; then
            if ! $PYTHON_BIN -m py_compile "$py_file"; then
                echo -e "${RED}${BOLD}[FAIL] Syntax error in ${py_file}!${NC}"
                echo -e "${YELLOW}Remediation:${NC}"
                echo "  Fix syntax errors in ${py_file} before committing."
                exit 1
            fi
        fi
    done <<< "$STAGED_PY_FILES"
    echo -e "${GREEN}[PASS]${NC} All staged Python files compiled successfully without syntax errors."
else
    echo -e "${GREEN}[PASS]${NC} No staged Python files to compile."
fi

# ------------------------------------------------------------------------------
# Gate 3: Lint & Code Style Check (Ruff / Flake8)
# ------------------------------------------------------------------------------
echo -e "${BLUE}[Gate 3/3]${NC} Running code linter checks..."

LINTER_EXECUTED=0

if [ -x ".venv/bin/ruff" ]; then
    echo -e "Using ruff from .venv..."
    if ! .venv/bin/ruff check .; then
        echo -e "${RED}${BOLD}[FAIL] Ruff linting issues detected!${NC}"
        echo -e "${YELLOW}Remediation:${NC}"
        echo "  Run: .venv/bin/ruff check --fix ."
        exit 1
    fi
    LINTER_EXECUTED=1
elif command -v ruff >/dev/null 2>&1; then
    echo -e "Using system ruff..."
    if ! ruff check .; then
        echo -e "${RED}${BOLD}[FAIL] Ruff linting issues detected!${NC}"
        echo -e "${YELLOW}Remediation:${NC}"
        echo "  Run: ruff check --fix ."
        exit 1
    fi
    LINTER_EXECUTED=1
elif [ -x ".venv/bin/flake8" ]; then
    echo -e "Using flake8 from .venv..."
    if ! .venv/bin/flake8 turzx turxz_scheduled_jobs tests --select=E4,E7,E9,F --ignore=E722,F401,F841 --max-line-length=120; then
        echo -e "${RED}${BOLD}[FAIL] Flake8 issues detected!${NC}"
        echo -e "${YELLOW}Remediation:${NC}"
        echo "  Run: .venv/bin/flake8 to see line numbers and fix violations."
        exit 1
    fi
    LINTER_EXECUTED=1
elif command -v flake8 >/dev/null 2>&1; then
    echo -e "Using system flake8..."
    if ! flake8 turzx turxz_scheduled_jobs tests --select=E4,E7,E9,F --ignore=E722,F401,F841 --max-line-length=120; then
        echo -e "${RED}${BOLD}[FAIL] Flake8 issues detected!${NC}"
        echo -e "${YELLOW}Remediation:${NC}"
        echo "  Run: flake8 to inspect and fix violations."
        exit 1
    fi
    LINTER_EXECUTED=1
fi

if [ "$LINTER_EXECUTED" -eq 1 ]; then
    echo -e "${GREEN}[PASS]${NC} Lint checks passed cleanly."
else
    echo -e "${YELLOW}[SKIP]${NC} Neither ruff nor flake8 available in environment. Skipping lint step."
fi

echo -e "${GREEN}${BOLD}✓ Pre-commit validation successful. Proceeding with commit.${NC}"
exit 0
